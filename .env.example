# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------

# Application environment: development | staging | production
NODE_ENV=development

# Enable debug mode for verbose logging
ENABLE_DEBUG=false

# Log level: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------

# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (if using OpenAI services)
# OPENAI_API_KEY=your_openai_api_key_here

# Other API keys as needed
# SOME_SERVICE_API_KEY=your_key_here

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable experimental features
ENABLE_EXPERIMENTAL=false

# Enable analytics/telemetry
ENABLE_ANALYTICS=false

# Enable hot reload in development
ENABLE_HOT_RELOAD=true

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Application port (for web servers)
PORT=3000

# API base URL (for external services)
# API_BASE_URL=https://api.example.com

# Database connection string (if applicable)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# -----------------------------------------------------------------------------
# Desktop App Settings (Tauri/Electron)
# -----------------------------------------------------------------------------

# Enable Tauri debug mode
TAURI_DEBUG=false

# Disable Tauri updater in development
TAURI_SKIP_DEVSERVER_CHECK=true

# -----------------------------------------------------------------------------
# Build Settings
# -----------------------------------------------------------------------------

# CI/CD environment flag
CI=false

# Skip certain checks in CI
# SKIP_PREFLIGHT_CHECK=true
